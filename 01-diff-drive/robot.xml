<!-- Robo diferencial: 2 rodas motorizadas + 2 rodizios (casters) sem atrito -->
<mujoco model="diffbot">
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".25 .3 .35" rgb2=".15 .2 .25" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance=".1"/>
  </asset>

  <default>
    <joint damping="0.002" armature="0.0005"/>
  </default>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 .1" material="grid" friction="1 .005 .0001"/>

    <!-- Centro do chassi na altura do eixo das rodas (raio 0.035 m) -->
    <body name="chassis" pos="0 0 0.035">
      <freejoint name="root"/>
      <geom name="body" type="box" size=".10 .07 .02" rgba=".85 .35 .2 1" mass="1.0"/>
      <!-- IMU no centro do chassi (licao 03) -->
      <site name="imu" pos="0 0 0"/>
      <!-- Seta indicando a frente do robo (+x) -->
      <geom type="box" pos=".09 0 .025" size=".015 .01 .005" rgba="1 1 1 1" mass="0" contype="0" conaffinity="0"/>

      <!-- Rodizios: condim=1 => contato sem atrito -->
      <geom name="caster_front" type="sphere" pos=".08 0 -.017" size=".015" condim="1" rgba=".5 .5 .5 1" mass=".02"/>
      <geom name="caster_back" type="sphere" pos="-.08 0 -.017" size=".015" condim="1" rgba=".5 .5 .5 1" mass=".02"/>

      <!-- Distancia entre rodas (wheel base) = 0.18 m -->
      <body name="left_wheel" pos="0 .09 0">
        <joint name="left" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size=".035 .01" euler="90 0 0" rgba=".1 .1 .1 1" mass=".05" friction="1.2 .005 .0001"/>
      </body>
      <body name="right_wheel" pos="0 -.09 0">
        <joint name="right" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size=".035 .01" euler="90 0 0" rgba=".1 .1 .1 1" mass=".05" friction="1.2 .005 .0001"/>
      </body>
    </body>
  </worldbody>

  <!-- Motores recebem torque (N.m). O PID e quem transforma "velocidade desejada" em torque. -->
  <actuator>
    <motor name="left_motor" joint="left" ctrlrange="-0.3 0.3" ctrllimited="true"/>
    <motor name="right_motor" joint="right" ctrllimited="true" ctrlrange="-0.3 0.3"/>
  </actuator>

  <sensor>
    <!-- Velocidade angular ideal no referencial do IMU. Os defeitos de um MEMS real sao adicionados no robot.py -->
    <gyro name="gyro" site="imu"/>
  </sensor>
</mujoco>
